# Kibana Dev Tools Console에는 요청 하나씩 복사해 실행한다.
# 현재는 요청을 저장한 상태다. 실제 응답은 evidence/day-02-data.md에 기록한다.

### V1-T09-C · 실제 cluster 상태 확인

GET /_cat/nodes?v

GET /_cat/nodes?v&h=name,ip,node.role,master,version

GET /_cat/indices?v

### V1-T09-P · index 생성 후 mapping 확인 요청

# index 생성 전에는 404 index_not_found_exception이 정상일 수 있다.
GET /my-products/_mapping

### V1-T12-P · 존재 확인

# 다음 교시에 먼저 실행한다. 이미 존재하면 아래 PUT을 실행하지 않는다.
GET /my-products

### V1-T12-P · index가 없을 때만 생성

PUT /my-products
{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "prd_id": {
        "type": "keyword"
      },
      "prd_nm": {
        "type": "text"
      },
      "in_stock": {
        "type": "boolean"
      },
      "category": {
        "type": "keyword"
      },
      "price": {
        "type": "integer"
      },
      "qty_score": {
        "type": "float"
      }
    }
  }
}

### V1-T12-P · 생성 후 검증

GET /my-products

GET /my-products/_mapping

GET /my-products/_count

GET /_cat/shards/my-products?v

### V1-T17-P · 기본 Search API — 자기 index 문서 수·전체 조회

# _count와 hits.total.value가 일치하는지 확인한다.
GET /audio-devices-search/_count

GET /audio-devices-search/_search
{
  "size": 5,
  "query": { "match_all": {} }
}

### V1-T18-1-P · 정확 조건(term) 검색 — AD-Q-EXACT

GET /audio-devices-search/_search
{
  "size": 10,
  "query": { "term": { "brand": "Sony" } }
}

### V1-T18-2-P · 전문 검색(match) 개선 전후 — AD-Q-FULLTEXT

# 개선 전 — standard analyzer가 조사를 분리하지 못해 저장 토큰과 불일치, 0건
GET /audio-devices-search/_search
{
  "size": 3,
  "query": { "match": { "review_summary": "저음 운동용" } }
}

# 개선 후 — 검색어를 실제 저장 토큰 형태(조사 포함)에 맞춤
GET /audio-devices-search/_search
{
  "size": 3,
  "query": { "match": { "review_summary": "저음이 강조되고 운동용으로" } }
}

### V1-T19-1-P · bool/filter 조건 제거 실험 (connection filter 제거)

GET /audio-devices-search/_search
{
  "size": 10,
  "_source": ["product_id", "category", "connection", "price"],
  "query": {
    "bool": {
      "must": [{ "match": { "review_summary": "노이즈" } }],
      "filter": [
        { "term": { "category": "이어폰" } },
        { "range": { "price": { "lte": 100000 } } }
      ]
    }
  }
}

### V1-T19-2-P · bool/filter 최종 — AD-Q-BOOLFILTER (Q1: 노이즈 캔슬링/10만원 이하 무선 이어폰)

GET /audio-devices-search/_search
{
  "size": 5,
  "query": {
    "bool": {
      "must": [{ "match": { "review_summary": "노이즈" } }],
      "filter": [
        { "term": { "category": "이어폰" } },
        { "term": { "connection": "무선" } },
        { "range": { "price": { "lte": 100000 } } }
      ]
    }
  }
}

### V1-T20-P · sort(1차·2차)와 highlight

# 1차 battery_hours desc, 2차 price asc — 헤드셋 카테고리
GET /audio-devices-search/_search
{
  "size": 5,
  "_source": ["product_id", "product_name", "price", "battery_hours", "rating"],
  "query": { "term": { "category": "헤드셋" } },
  "sort": [
    { "battery_hours": "desc" },
    { "price": "asc" }
  ]
}

# 검색어 매칭 근거를 보여주는 highlight
GET /audio-devices-search/_search
{
  "size": 3,
  "_source": ["product_id", "product_name"],
  "query": { "match": { "review_summary": "저음이 강조되고 운동용" } },
  "highlight": { "fields": { "review_summary": {} } }
}

### V1-T21-P · 의도한 0건 확인과 원인 분석

# 존재하지 않는 product_id 값으로 정상 0건(오류 아님) 확인
GET /audio-devices-search/_search
{
  "size": 5,
  "query": { "term": { "product_id": "__DAY03_INTENTIONAL_ZERO__" } }
}

# 전문 검색 0건 실패의 1차 원인 분석 — review_summary 토큰화 결과 확인
POST /audio-devices-search/_analyze
{
  "field": "review_summary",
  "text": "저음이 강조되고 운동용으로 딱입니다."
}

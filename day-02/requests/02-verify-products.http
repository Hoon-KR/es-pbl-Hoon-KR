### 문서 수 확인: 10,000이어야 한다.
GET /products/_count

### Dashboard용 카테고리·브랜드·재고 분포 확인
GET /products/_search
{
  "size": 0,
  "aggs": {
    "by_category": { "terms": { "field": "category", "size": 10 } },
    "top_brands": { "terms": { "field": "brand", "size": 10, "shard_size": 100 } },
    "stock_state": { "terms": { "field": "in_stock" } },
    "price_distribution": { "histogram": { "field": "price", "interval": 50000 } }
  }
}

### 검색 품질 확인: 제목 또는 설명에 '무선 이어폰'이 포함되는지 본다.
GET /products/_search
{
  "size": 5,
  "query": {
    "multi_match": {
      "query": "무선 이어폰",
      "fields": ["name^3", "description"]
    }
  },
  "highlight": { "fields": { "name": {}, "description": {} } }
}
